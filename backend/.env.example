# =============================================================================
# 产线转产管理轻应用 · 环境变量样例
#   Windows：copy .env.example .env   然后编辑
#   Linux  ：cp .env.example .env     然后编辑（systemd 用 EnvironmentFile 读取）
#
# ⚠ 两条铁律：
#   1) 不要提交 .env 到版本库（已在 .gitignore）
#   2) JWT_SECRET 必须是强随机值；SMB 生产账号必须是专用服务账号（禁用匿名）
# 注意：systemd 的 EnvironmentFile 不解析 export；反斜杠是转义符，
#       Windows 风格路径统一写双反斜杠（如 slenk_\\FA_ROOT），Windows/Linux 通用。
# =============================================================================

# ---- 服务绑定 ----
APP_HOST=0.0.0.0
APP_PORT=8000
# Windows scripts\start_backend.bat 默认优先 8001，用于前后端分离联调；如需固定请保留/修改 APP_PORT

# ---- 数据库（SQLite 元数据；照片不入库） ----
# 缺省 backend/data/app.db；生产建议放独立数据盘
# DB_PATH=D:/changeover/data/app.db

# ---- 认证（必配：否则无法登录） ----
JWT_SECRET=CHANGE_ME_请用随机长串
JWT_EXPIRE_HOURS=12

# ---- SMB 照片存储（生产必配：否则照片上传/归档返回 503） ----
# 例：SMB_HOST=10.118.1.66  SMB_SHARE=pub  SMB_ROOT=slenk_\\FA_ROOT
SMB_HOST=
SMB_SHARE=
SMB_ROOT=
SMB_USER=
SMB_PASSWORD=
# SMB_DOMAIN=

# ---- 图片与草稿 ----
MAX_IMAGE_MB=10
MAX_IMAGE_EDGE=1920
DRAFT_TTL_DAYS=7

# ---- 前端托管（单端口部署：后端同时提供 API 与页面，免装 Nginx） ----
# auto=有 index.html 才托管；on=强制；off=仅 API（配合 Nginx 方案时设 off）
SERVE_FRONTEND=auto
# FRONTEND_DIST=../frontend/dist

# ---- WB 参数查询（模块②） ----
# auto: 优先 wb_mail.mes_api → 其次 HTTP 端点 → 都没有则 503
# 可选：off | mock | http | mes | auto
WB_SOURCE=auto
# wb_mail 包所在目录（需加入 sys.path 时填；同机部署可留空）
WB_MAIL_PATH=
# HTTP 回退端点（可选）
# WB_BY_BATCH_URL=
# WB_BY_BOM_URL=

# ---- MES / 业务端点（wb_mail 使用；按现场提供填写） ----
TIOT_URL=
MID_API_URL=
ODF_URL=
MES_API_BASE=
MES_DOMAIN=
MES_REFERER=

# ---- 种子管理员（仅首次建库时生效；首次登录强制改密） ----
SEED_ADMIN_EMP_ID=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
